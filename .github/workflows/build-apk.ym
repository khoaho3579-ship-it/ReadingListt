name: Build APK
on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Giai nen du an
        run: unzip -q ReadingList.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - name: Tao keystore
        working-directory: ReadingList
        run: |
          keytool -genkeypair -keystore release.keystore -alias release \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass freddyrelease -keypass freddyrelease \
            -dname "CN=ReadingList, OU=Freddy, O=Freddy, C=US"
      - name: Build APK
        working-directory: ReadingList
        run: gradle assembleRelease --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: ReadingList-apk
          path: ReadingList/app/build/outputs/apk/release/app-release.apk
